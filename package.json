{
  "name": "@bwnd/bbot",
  "version": "0.6.1",
  "description": "A face for AI agents: 30 expressions people read at a glance, 9 reactions, lip-synced speech. Reference renderer for the Agent Face Protocol. No dependencies.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/face.js",
  "exports": {
    ".": "./dist/face.js",
    "./react": "./dist/react.js",
    "./face.css": "./dist/face.css",
    "./core": "./src/core.js",
    "./expressions": "./src/expressions.js",
    "./package.json": "./package.json",
    "./fx": "./dist/fx.js",
    "./talk": "./dist/talk.js"
  },
  "files": [
    "dist",
    "src",
    "spec",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "demo": "npx --yes http-server . -p 8080 -c-1",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "keywords": [
    "face",
    "eyes",
    "svg",
    "animation",
    "cursor",
    "mouse",
    "avatar",
    "mascot",
    "spring",
    "react",
    "agent",
    "ai-agent",
    "emotion",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bwndapp/bbot.git"
  },
  "homepage": "https://bbot.bwnd.app"
}
